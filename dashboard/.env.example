# Private local use only. Copy this file to .env.local and fill in your keys.
# Keys are read ONLY by the local backend server (dashboard/server/index.mjs).
# NEVER paste these into the browser / frontend. .env.local is gitignored.
# Connected so far: OpenAI and OpenRouter text/JSON. Others remain placeholders.

OPENAI_API_KEY=
# Model used for OpenAI text/JSON calls. Defaults to gpt-5.5 if left blank.
OPENAI_MODEL=gpt-5.5

# OpenAI text-to-image (generate_image). REQUIRED to use image generation — there
# is no default. Not needed for text/JSON. Image API uses separate API credits.
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional image options (sent only if set):
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=low

OPENROUTER_API_KEY=
# Model id for OpenRouter text/JSON calls. REQUIRED when using OpenRouter — there
# is no default. Example: openai/gpt-4o-mini  or  anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=

ANTHROPIC_API_KEY=
GEMINI_API_KEY=
